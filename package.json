{
  "name": "bananasaurs",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run typecheck && npm run build --workspaces --if-present",
    "typecheck": "tsc --build --force && tsc -p tsconfig.all.json",
    "lint": "eslint apps/daemon && eslint packages/core && eslint packages/storage && eslint packages/http && eslint packages/dashboard && eslint packages/cli packages/discord packages/mcp packages/testkit && eslint vitest.config.ts eslint.config.js drizzle.config.ts && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "node --env-file=.env --watch apps/daemon/src/index.ts",
    "start": "node --env-file=.env apps/daemon/dist/index.js",
    "doctor": "node --env-file=.env apps/daemon/dist/index.js --doctor",
    "db:generate": "drizzle-kit generate",
    "postdb:generate": "node scripts/strictify.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "restore": "node scripts/restore.mjs",
    "smoke:cards": "node --env-file=.env scripts/card-gallery.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^5.0.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@node-rs/argon2": "^2.2.0"
  },
  "allowScripts": {
    "better-sqlite3": false,
    "esbuild": false
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
}
