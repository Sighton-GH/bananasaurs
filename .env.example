# Bananasaurs environment configuration
#
# Copy this file to `.env` and fill in the real values:
#     cp .env.example .env
#     chmod 600 .env
#
# `.env` is gitignored and must never be committed. `.env.example` is committed
# and must never contain a real secret. If you ever paste a token into this file
# by accident, treat it as leaked: regenerate it in the Discord Developer Portal.
#
# Claude Code is configured (in .claude/settings.json) to refuse to read `.env`,
# so your token cannot end up in a transcript or a commit.


# ─────────────────────────────────────────────────────────────────────────────
# Discord application
# ─────────────────────────────────────────────────────────────────────────────

# Developer Portal → your app → Bot → Reset Token.
# This is the most dangerous string in the project. Anyone holding it controls
# the bot. Keep a copy in a password manager, not in a chat or a text file.
DISCORD_BOT_TOKEN=

# Developer Portal → General Information → Application ID
DISCORD_APPLICATION_ID=

# Developer Portal → General Information → Public Key
# Not needed for a gateway bot, but harmless to record now.
DISCORD_PUBLIC_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# Guild scope — the most important safety setting in this file
# ─────────────────────────────────────────────────────────────────────────────

# Comma-separated guild IDs Bananasaurs is allowed to operate in.
# Any guild not listed here: log and leave, no exceptions.
#
# For development this contains ONLY your test guild. This is the backstop that
# stops a dev run from ever touching the club server, so get it right.
BANANASAURS_GUILD_ALLOWLIST=

# Your Discord user ID (Developer Mode on → right-click yourself → Copy User ID).
# Bootstraps the owner capability grant on first run.
BANANASAURS_OWNER_USER_ID=


# ─────────────────────────────────────────────────────────────────────────────
# Archive scope (ADR 0046)
# ─────────────────────────────────────────────────────────────────────────────

# Comma-separated guild IDs whose channels MAY be archived. Bare IDs — no
# quotes, no brackets.
#
# Empty (the default) means the archive subsystem is entirely inert: no
# ingestion, no backfill, and the MCP archive tools (search_messages,
# read_channel_history, get_message) return empty results rather than errors.
# That silence is easy to mistake for "nothing to find", so set this
# deliberately or leave it deliberately empty.
#
# Listing a guild here is necessary but NOT sufficient. Each channel must also
# be enabled one at a time with `bananasaurs archive enable-channel <id>
# --guild <id> --confirm`, and an excluded channel is still refused.
#
# Every guild listed here must also be in BANANASAURS_GUILD_ALLOWLIST; doctor
# reports any that is not. Archived content is purged at 30 days unless it is
# preserved or linked to a moderation case.
#
# Adding a real guild ingests real members' messages. That is a deliberate
# privacy decision, not a testing convenience.
BANANASAURS_ARCHIVE_GUILDS=


# ─────────────────────────────────────────────────────────────────────────────
# Runtime mode
# ─────────────────────────────────────────────────────────────────────────────

# development | production
BANANASAURS_ENV=development

# 1 = every Discord side effect becomes a log line instead of an API call.
# Events still process, decisions still get made, audit rows still get written
# and marked dry_run. Nothing changes in Discord.
#
# Leave this at 1 until you have deliberately decided otherwise. See docs/18.
BANANASAURS_DRY_RUN=1

# trace | debug | info | warn | error
BANANASAURS_LOG_LEVEL=info


# ─────────────────────────────────────────────────────────────────────────────
# Paths — must differ between the dev and production instances on this host
# ─────────────────────────────────────────────────────────────────────────────

# Development:  ~/bananasaurs-dev/data
# Production:   /opt/bananasaurs/data
BANANASAURS_DATA_DIR=./data

# Development:  ~/bananasaurs-dev/data/bananasaurs.db
# Production:   /opt/bananasaurs/data/bananasaurs.db
BANANASAURS_DB_PATH=./data/bananasaurs.db

# Operator CLI socket. Different paths per instance so the CLI can never
# address the wrong one.
# Development:  ./run/admin.sock
# Production:   /run/bananasaurs/admin.sock
BANANASAURS_SOCKET_PATH=./run/admin.sock


# ─────────────────────────────────────────────────────────────────────────────
# MCP operator server (slices M3–M6)
# ─────────────────────────────────────────────────────────────────────────────

# The public https origin the MCP server is reached at through the Cloudflare
# Tunnel. It is also the OAuth `issuer`, which is why it must be an exact,
# bare origin: https, no path, no query, no fragment, no trailing slash.
# (127.0.0.1 is accepted for local development.)
#
# OPTIONAL, AND IT IS THE OPT-IN. With this unset the daemon mounts no MCP
# surface at all: GET /mcp answers 404 and the OAuth routes — /oauth/authorize,
# /oauth/token, /oauth/register, /oauth/revoke and both .well-known documents —
# are never registered. That is the intended state for an instance that is not
# publishing one, and it is also the first thing to check if a connector
# reports "not found" on a hostname that is otherwise reachable.
#
# Set this only once the tunnel and the Cloudflare Access applications exist
# (docs/17 §2.4): one identity policy on the hostname, and a Bypass policy on
# the six machine paths. `bananasaurs doctor` probes all five path classes from
# outside and reports PROBLEMS FOUND if the dashboard answers without Access,
# or if a machine path answers with it.
#
# Not a secret — it is a public hostname, and it appears in the OAuth metadata
# any client can fetch.
MCP_PUBLIC_URL=https://bananasaurs.sighton.ca

# ─────────────────────────────────────────────────────────────────────────────
# Dashboard
# ─────────────────────────────────────────────────────────────────────────────

DASHBOARD_PORT=8787

# Bind address. Loopback only, and the daemon refuses anything else: the
# accepted values are 127.0.0.1, localhost and ::1.
#
# If the dashboard "doesn't load" from your laptop, the fix is not a wider bind
# — it is a tunnel:
#     ssh -L 8787:127.0.0.1:8787 <host>
# then open http://127.0.0.1:8787 in your own browser. Tailscale works too.
# 0.0.0.0 would put a password form holding the kill switch on the LAN.
DASHBOARD_BIND=127.0.0.1

# Unused since ADR 0029, and optional. Dashboard sessions are stored in the
# database rather than signed into a cookie, specifically so revocation is
# immediate — so there is nothing to sign, and changing this logs nobody out.
# Leave it blank or delete the line; if you already set a value it is still
# treated as a secret and never logged.
# DASHBOARD_SESSION_SECRET=


# ─────────────────────────────────────────────────────────────────────────────
# Safety limits (docs/18)
# ─────────────────────────────────────────────────────────────────────────────

# Max role mutations per minute before the circuit breaker trips and stops.
# 20 is generous for a 30-member club. Lower is safer.
BANANASAURS_ROLE_RATE_LIMIT_PER_MIN=20

# Consecutive failed Discord API calls before the breaker trips.
BANANASAURS_ERROR_BREAKER_THRESHOLD=5

# A reconciliation pass computing more changes than this refuses to run and
# asks for confirmation instead. A normal repair touches a handful of members.
BANANASAURS_RECONCILE_BUDGET=25


# ─────────────────────────────────────────────────────────────────────────────
# Backup (ADR 0034, docs/19 §6.12)
# ─────────────────────────────────────────────────────────────────────────────

# A sibling of BANANASAURS_DATA_DIR, not nested inside it — matches
# deploy/bananasaurs.service's ReadWritePaths.
BANANASAURS_BACKUP_DIR=./backups

# How often the daemon takes a backup. It also takes one immediately on
# startup, so a fresh install is never a full interval away from its first one.
BANANASAURS_BACKUP_INTERVAL_MIN=1440

# How many backups to keep. Older ones (and their .sha256 sidecars) are
# deleted; anything else in the directory is left alone.
BANANASAURS_BACKUP_RETAIN=14


# ─────────────────────────────────────────────────────────────────────────────
# AI providers — Release 3 only. Leave empty until then.
# ─────────────────────────────────────────────────────────────────────────────

# ---- Release 3 assistant provider (ADR 0057) -------------------------------
# Everything here defaults to OFF. With AI_PROVIDER=off (or unset) the bot
# runs exactly as Releases 1 and 2 did; no provider is constructed.
#
# AI_PROVIDER: off | gemini | openrouter | nvidia-nim
# AI_MODEL: explicit model id for that provider. Never pinned in code.
# AI_PROFILE_COST_CLASS: free | paid | unknown. The spend cap is ZERO, so only
#   a profile you have classified as `free` is ever allowed to send. The
#   default `unknown` fails closed on EVERY request (hard rule 5 / ADR 0057
#   amendment 1) - set it deliberately.
# Each provider also needs a provider_eligibility row with
# trains_on_input = 'no' and a cited ToS clause (see the Providers page);
# without one the request path refuses before any content leaves the box.
# AI_PROVIDER=off
# AI_MODEL=
# AI_PROFILE_COST_CLASS=unknown
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# NVIDIA_NIM_API_KEY=
# NVIDIA NIM's free tier is for development, testing and evaluation only
# (ADR 0010): its eligibility row carries productionUseAllowed = false and the
# club audience is refused from it. Test guild and synthetic content only.

# NOTE: there is deliberately no Claude subscription credential here, and there
# never will be. See ADR 0013. Claude Code builds and operates Bananasaurs;
# it never serves a Discord request.
