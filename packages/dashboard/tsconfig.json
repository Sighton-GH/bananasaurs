{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist-types",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": []
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  // Only `*.test.ts` is excluded: `tsconfig.all.json` covers it (node
  // program). `*.test.tsx` needs this project's DOM lib and `jsx` to
  // type-check, and eslint's `parserOptions.project` resolves each file
  // against whichever project includes it — excluded-from-both meant the
  // component tests failed lint with a project-resolution parse error.
  "exclude": ["src/**/*.test.ts"]
}
