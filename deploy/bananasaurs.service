# Bananasaurs daemon. See docs/17_OPERATOR_ACCESS.md.
#
#   sudo cp deploy/bananasaurs.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now bananasaurs
#
# Bryan runs those three commands. Nothing in this repository needs root.

[Unit]
Description=Bananasaurs Discord assistant
Documentation=https://github.com/Sighton-GH/bananasaurs
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bananasaurs
# The *ops* group, not the service group. RuntimeDirectory and every file the
# process creates take the primary group, so this is what makes the admin
# socket `bananasaurs:bananasaurs-ops` as docs/17 §2.1 specifies. With
# `Group=bananasaurs` the socket is 0660 root-of-the-wrong-group and nobody in
# bananasaurs-ops can reach the CLI — the failure docs/19 §10 warns is easy to
# get wrong and hard to diagnose. The daemon chmods the socket to 0660 itself
# and logs its actual uid/gid/mode at startup, so a mismatch is visible in the
# journal rather than silent.
Group=bananasaurs-ops
WorkingDirectory=/opt/bananasaurs

# Root-owned, 0640, group bananasaurs. Never in the repository (ADR 0008).
EnvironmentFile=/etc/bananasaurs/env

# Creates /run/bananasaurs owned by bananasaurs:bananasaurs-ops. UMask 0007
# gives the admin socket group read/write, which is what puts bananasaurs-ops
# members in reach of the operator CLI without sudo (ADR 0013). Group
# membership is the only access control on that socket (ADR 0024).
RuntimeDirectory=bananasaurs
RuntimeDirectoryMode=0750
UMask=0007

ExecStart=/usr/bin/node /opt/bananasaurs/apps/daemon/dist/index.js
Restart=on-failure
RestartSec=5s

# The process needs its data directory and nothing else on the filesystem.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
ReadWritePaths=/opt/bananasaurs/data /opt/bananasaurs/backups

# Discord over HTTPS and a unix socket. Nothing else.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

StandardOutput=journal
StandardError=journal
SyslogIdentifier=bananasaurs

[Install]
WantedBy=multi-user.target
